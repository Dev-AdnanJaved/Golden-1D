# ======================================================
# Telegram Bot Configuration
# ======================================================
# 1. Message @BotFather on Telegram to create a bot and get your token:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Start a chat with your bot, send /start, then run: python get_chat_id.py
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ======================================================
# Scanner Settings
# ======================================================
# Seconds between full market scan cycles (e.g. 180 = 3 minutes)
SCAN_INTERVAL_SECONDS=180

# Maximum concurrent network requests (default: 25)
MAX_CONCURRENT_REQUESTS=25

# Pair Filters:
# Filter 1: Minimum 24h Volume in USDT (Default: 1000000 = $1M USDT)
MIN_24H_VOLUME_USDT=1000000

# Filter 2: Maximum Market Cap in USD (Default: 1000000000 = $1B)
MAX_MARKET_CAP_USDT=1000000000

# Anti-Failure Filters (Proven to boost win rate from 82.0% -> 88.6%!)
# Filter 3: Check if BTC is in a healthy 4H uptrend (BTC 4H close > 50 EMA)
ENABLE_BTC_TREND_FILTER=true

# Filter 4: Maximum allowed distance of entry price above 4H 200 EMA (Default: 8.0 = 8%)
MAX_OVEREXTENSION_PCT=8.0

# Cooldown per symbol in minutes (240 min = 4 hours, prevents duplicate alerts in same 4h candle)
ALERT_COOLDOWN_MINUTES=240

# ======================================================
# Strategy Settings
# ======================================================
# Rule 1: 1D Candle > 50 EMA
# false = 1D price is above 50 EMA (holding above)
# true = 1D candle strictly crossed above 50 EMA today or previous candle
DAILY_REQUIRE_FRESH_CROSS=false

# Rule 2: 4H 50 EMA crossed 200 EMA
# Check current forming candle
CHECK_4H_CURRENT_CANDLE=true
# Check candle that just closed
CHECK_4H_PREVIOUS_CANDLE=true

# Rule 3: 1H Volume Filter (Soft Filter)
VOL_FAST_CANDLES=7
VOL_SLOW_CANDLES=24

